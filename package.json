{
  "name": "richman-estate-v3",
  "version": "3.0.0",
  "private": true,
  "description": "Richman Estate RP — Vitrine de luxe, flotte prestige, suites & conciergerie. Rebuild Vite + TypeScript.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "bot": "npm --prefix bot run start",
    "bot:dev": "npm --prefix bot run dev",
    "test": "node tests/test_suite.js",
    "test:assets": "node tests/check_assets.js",
    "audit": "node tests/audit_system.js",
    "test:all": "npm run build && npm run test && npm run test:assets && npm run audit"
  },
  "keywords": [
    "richman-estate",
    "luxury",
    "gta-rp",
    "discord-bot",
    "supabase",
    "vite",
    "typescript"
