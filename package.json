  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dompurify": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
